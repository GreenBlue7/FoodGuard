# Copy to deploy/.env. Never commit real values.
POSTGRES_DB=foodguard
POSTGRES_USER=postgres
# Use a long random hexadecimal password (URL-safe, also used in judge DATABASE_URL).
POSTGRES_PASSWORD=
# Base64 encoding of at least 32 random bytes. Keep stable across restarts.
JWT_SECRET=
PUBLIC_SERVICE_URL=https://foodguard.example.com
BACKEND_HOST_PORT=8080

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
FOOD_SAFETY_API_KEY=
# Enable after keys/data and a single scheduler instance have been verified.
FOOD_SAFETY_SCHEDULED_REFRESH_ENABLED=false
FOOD_SAFETY_REFRESH_CRON=0 0 3 * * *

NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_EMAIL_FROM=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
