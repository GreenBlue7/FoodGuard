# .env로 복사해서 사용

# judge 엔진
# Gemini 를 부르는 길
#   gemini     : Google 에 직접. 개발할 때 각자 무료 키로 (기본값)
#   openrouter : OpenRouter 경유. 팀 크레딧이 나가므로 시연·평가 때만
LLM_PROVIDER=gemini
# Google AI Studio에서 각자 발급 (LLM_PROVIDER=gemini 일 때)
GEMINI_API_KEY=
# OpenRouter 팀 계정에서 각자 받은 키 (LLM_PROVIDER=openrouter 일 때). 공유·커밋 금지
OPENROUTER_API_KEY=
# 모델 이름은 어느 길이든 Google 이름 그대로 (google/ 을 붙이지 않음)
GEMINI_MODEL=gemini-3.1-flash-lite

# judge 스크립트를 docker 밖(내 PC)에서 실행할 때 쓰는 DB 주소
# docker compose 안의 judge는 이 값을 쓰지 않고 compose가 직접 넣어 줌
DATABASE_URL=postgresql://postgres:devpass@localhost:5433/foodguard

# 백엔드 DB 
# 아래는 docker compose의 DB(5433) 기준. 다른 DB를 쓰면 그 주소로 바꿀 것
DB_URL=jdbc:postgresql://localhost:5433/foodguard
DB_USERNAME=postgres
DB_PASSWORD=devpass

# 백엔드 로그인 (JWT)
# 필수. `openssl rand -base64 32`의 출력값을 붙여넣기. 비어 있으면 백엔드가 시작되지 않음
# 각자 다른 값을 쓰고 공유·커밋 금지 (이 값을 알면 아무 계정의 토큰이나 만들 수 있음)
JWT_SECRET=

# localhost가 아닌 주소(예: http://192.168.x.x:5173)로 접속할 때만 주석 해제
# 로그인 유지 쿠키가 HTTPS 전용이라, 이걸 안 하면 새로고침할 때마다 로그아웃됨
# JWT_REFRESH_COOKIE_SECURE=false

# 식약처 Open API 키. 제품 데이터는 시드로 자동 적재되므로 평소에는 필요 없음
# 제품 데이터를 새로 받아 시드를 다시 만들 때만 사용 (ADMIN 계정 필요)
# FOOD_SAFETY_API_KEY=
# FOOD_SAFETY_IMPORT_ENABLED=true

# judge 확인 단계 모델. 비워 두면 코드 기본값 gemini-3.6-flash (평가한 모델)
# gemini-3.5-flash 는 쓰지 말 것: OpenRouter 에서는 3.6 보다 2배 넘게 비싸다
# 다른 모델로 바꾸면 판정 결과가 달라진다 (평가하지 않은 설정)
# JUDGE_STRONG_MODEL=gemini-3.6-flash

# 백엔드가 judge 응답을 기다리는 시간(ms). 기본값 30000은 실제 판정 시간보다 짧음
# frontend/nginx.conf의 proxy_read_timeout(180초)보다 작아야 함
JUDGE_TIMEOUT_MS=120000

# Docker 전체 실행 시 브라우저 접속 포트. 8080을 다른 프로그램이 쓸 때만 바꿀 것
# FRONTEND_PORT=8080
