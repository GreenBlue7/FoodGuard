# .env로 복사해서 사용

# judge 엔진
# Google AI Studio에서 각자 발급
GEMINI_API_KEY=

GEMINI_MODEL=gemini-3.1-flash-lite

# judge 스크립트를 docker 밖(내 PC)에서 실행할 때 쓰는 DB 주소
# docker compose 안의 judge는 이 값을 쓰지 않고 compose가 직접 넣어 줌
DATABASE_URL=postgresql://postgres:devpass@localhost:5433/foodguard

# 백엔드 DB 
# 아래는 docker compose의 DB(5433) 기준. 다른 DB를 쓰면 그 주소로 바꿀 것
DB_URL=jdbc:postgresql://localhost:5433/foodguard
DB_USERNAME=postgres
DB_PASSWORD=devpass

# 백엔드 로그인 (JWT)
# 필수. `openssl rand -base64 32`의 출력값을 붙여넣기. 비어 있으면 백엔드가 시작되지 않음
# 각자 다른 값을 쓰고 공유·커밋 금지 (이 값을 알면 아무 계정의 토큰이나 만들 수 있음)
JWT_SECRET=

# localhost가 아닌 주소(예: http://192.168.x.x:5173)로 접속할 때만 주석 해제
# 로그인 유지 쿠키가 HTTPS 전용이라, 이걸 안 하면 새로고침할 때마다 로그아웃됨
# JWT_REFRESH_COOKIE_SECURE=false

# MFDS refresh: daily 03:00 Asia/Seoul; full collection every 7 successful calendar days.
FOOD_SAFETY_API_KEY=
FOOD_SAFETY_API_BASE_URL=https://openapi.foodsafetykorea.go.kr/api
FOOD_SAFETY_SCHEDULED_REFRESH_ENABLED=false
FOOD_SAFETY_REFRESH_CRON=0 0 3 * * *
FOOD_SAFETY_IMPORT_ENABLED=false
JUDGE_TIMEOUT_MS=180000

# Real SMTP requires sender verification, credentials and public service URLs.
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_EMAIL_FROM=foodguard@localhost
NOTIFICATION_EMAIL_PUBLIC_API_URL=http://localhost:8080
NOTIFICATION_EMAIL_PUBLIC_WEB_URL=http://127.0.0.1:5173
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false

# Separate deployment configuration and instructions: deploy/README.md

# Durable background inspection worker (one job at a time).
INSPECTION_JOBS_WORKER_ENABLED=true
INSPECTION_JOBS_POLL_MS=1000
INSPECTION_JOBS_LEASE_MS=600000
