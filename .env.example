# Copy to .env (git-ignored). docker compose and the Spring backend
# (via spring.config.import) read it. Do not quote values.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
DATABASE_URL=postgresql://localhost:5432/foodguard

# Backend JWT signing key: paste the output of `openssl rand -base64 32`.
# Each developer uses their own value; never commit the real one.
JWT_SECRET=
